{
  "expo": {
    "name": "Convert",
    "slug": "Convert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "convert",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kikirim.Convert",
      "appleTeamId": "VCJS2UR6B3",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Dönüştürmek veya kesmek istediğiniz videoları seçebilmek için galeri erişimi gereklidir.",
        "NSPhotoLibraryAddUsageDescription": "İşlenen medya dosyalarını galerinize kaydedebilmek için izin gereklidir."
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "package": "com.kikirim.Convert",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-document-picker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
